# ---- App database (Prisma) ----
DATABASE_URL=postgresql://loopclose:loopclose@localhost:5432/loopclose

# ---- HAPI FHIR server ----
FHIR_BASE_URL=http://localhost:8080/fhir

# ---- API ----
API_PORT=4000
JWT_SECRET=dev-only-change-me
JWT_ISSUER=loopclose-dev
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- AI (api service only; never expose to web) ----
ANTHROPIC_API_KEY=
AI_NAVIGATOR_MODEL=claude-sonnet-5-5
AI_GRADER_MODEL=claude-haiku-5-5
AI_SUMMARISER_MODEL=claude-sonnet-5-5
# Kill-switches (true/false). Also toggleable at runtime from admin UI.
AI_FEATURE_NAVIGATOR=true
AI_FEATURE_SUMMARISER=true
AI_FEATURE_RISK=true

# ---- Channels (simulated by default) ----
CHANNEL_WHATSAPP_MODE=simulated   # simulated | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
SMTP_HOST=localhost
SMTP_PORT=1025

# ---- Demo controls (disabled when NODE_ENV=production) ----
DEMO_MODE=true
DEMO_CLOCK_OFFSET_HOURS=0

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=en
