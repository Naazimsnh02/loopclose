{
  "name": "loopclose",
  "version": "0.1.0",
  "private": true,
  "description": "LoopClose — closed-loop screening results management (Future Health Digital Innovation Challenge, Challenge 05)",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "dev": "pnpm -r --parallel --filter './apps/**' dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --filter \"./packages/*\" build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "infra:up": "docker compose up -d postgres hapi mailhog",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "db:migrate": "pnpm --filter @loopclose/api prisma:migrate",
    "db:seed": "pnpm --filter @loopclose/api seed",
    "demo": "pnpm infra:up && pnpm db:migrate && pnpm db:seed && pnpm dev",
    "format": "prettier --write \"**/*.{ts,tsx,md,yaml,yml,json}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
